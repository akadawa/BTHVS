{
  "version": 2,
  "outputDirectory": "dist",
  "buildCommand": "echo Prebuilt dist ready",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/game/corsixth.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/game/corsixth.data",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
